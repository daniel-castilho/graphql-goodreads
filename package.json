{
  "name": "graphql-goodreads",
  "version": "1.0.0",
  "description": "A minimal GraphQL API exposing authors and their books through a typed schema with interactive GraphiQL documentation. Pluggable data providers: Open Library (default, key-free) and the legacy Goodreads XML API.",
  "main": "server.js",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "test:watch": "node --test --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-castilho/graphql-goodreads.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/daniel-castilho/graphql-goodreads/issues"
  },
  "homepage": "https://github.com/daniel-castilho/graphql-goodreads#readme",
  "dependencies": {
    "express": "^4.22.2",
    "graphql": "^16.14.2",
    "graphql-http": "^1.23.0",
    "nodemon": "^2.0.4",
    "xml2js": "^0.6.2"
  },
  "overrides": {
    "simple-update-notifier": {
      "semver": "^7.5.2"
    }
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "graphql",
    "goodreads",
    "openlibrary",
    "open-library",
    "express",
    "api",
    "books"
  ]
}
