# Goodreads API key — https://www.goodreads.com/api/keys
# NOTE: Goodreads stopped issuing new developer keys (Dec 2020) and is retiring
# the API. Existing keys may still work; the project fails fast if this is
# missing.
GOODREADS_API_KEY=

# Upstream request timeout in milliseconds (default: 10000).
UPSTREAM_TIMEOUT_MS=10000
