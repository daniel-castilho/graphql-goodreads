# Data provider: "openlibrary" (default, no key needed) or "goodreads".
BOOK_PROVIDER=openlibrary

# Goodreads API key — only required when BOOK_PROVIDER=goodreads.
#
# IMPORTANT: Goodreads stopped issuing new developer keys in December 2020 and is retiring the
# API. Existing keys may stop working at any time (the API returns HTTP 401 Invalid API key).
#
# Production bar: a real legacy key (when one is available), injected via your secret manager —
# never committed. The server fails fast at startup when this variable is missing and
# BOOK_PROVIDER=goodreads.
GOODREADS_API_KEY=

# Upstream request timeout in milliseconds (default: 10000).
UPSTREAM_TIMEOUT_MS=10000
